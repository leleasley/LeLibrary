# The GHCR build starts from an empty context and admits only public runtime
# files. Keep the explicit hosted-file exclusions below as a second guard.
*
!package.json
!package-lock.json
!backend/**
!frontend/**
frontend/node_modules/
frontend/dist/
!README.md
!LICENSE

# Hosted/operator-only files are never part of the public image.
backend/src/accounts/
backend/src/registry.ts

# Instance-specific sitemap (listed in .gitignore; never publish prod URLs).
frontend/public/sitemap.xml

# Hosted-only artwork and the dev-only art review page.
frontend/public/collection-art/
frontend/public/art-review/
frontend/public/guide/videos/

# Development, test, documentation, secrets and repository state.
test/
Docs/
.git/
.github/
.env
.env.*
!.env.example
compose.yml
node_modules/
npm-debug.log*
*.pem
*.key
*.crt
*.sqlite*
*.db
