{
  "name": "lelibrary-frontend",
  "private": true,
  "version": "5.5.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run check:i18n && tsc -b && vite build && node prerender-home.mjs",
