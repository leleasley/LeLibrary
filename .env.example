PORT=7860
# Runtime settings used by compose.example.yml.
LELIBRARY_PORT=7860
LELIBRARY_MEMORY_LIMIT=1g
REDIS_CONTAINER_MEMORY_LIMIT=768m
REDIS_HOST=redis
REDIS_PORT=6379
# Required for self-hosted saved setups. Generate it with:
# openssl rand -hex 32
SELFHOST_CONFIGS_SECRET=
# REDIS_PASSWORD=
# REDIS_TLS=false

# Optional account watchlist OAuth connections. Register these callback URLs:
# https://your-domain/api/oauth/simkl/callback
# https://your-domain/api/oauth/trakt/callback
# SIMKL_CLIENT_ID=
# SIMKL_CLIENT_SECRET=
# TRAKT_CLIENT_ID=
# TRAKT_CLIENT_SECRET=

# Optional Cloudflare Turnstile bot protection (managed, invisible) for
# anonymous /api/save-config saves. Each environment uses its own widget:
# dev and prod get different site keys AND secrets. Leave all three empty to
# disable (self-hosted installs stay exactly as before).
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET= (or TURNSTILE_SECRET_KEY: both accepted, TURNSTILE_SECRET wins)
# Comma-separated frontend hostnames a token must be issued for.
# Production must NOT include localhost or 127.0.0.1.
# TURNSTILE_HOSTNAMES=lelibrary.uk

# Optional Pictorium poster studio. LeLibrary calls it server-side, so this URL
# is never exposed to users and may be an internal address. Leave unset when the
# companion container is named "pictorium" on the same Docker network (the
# built-in default already points there). Users can still bring their own
# instance from the Configure page; that field is public HTTPS only.
# PICTORIUM_URL=http://pictorium:8080
