FROM node:24-alpine AS frontend

WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci && npm cache clean --force
COPY frontend/ ./
RUN npm run build

FROM node:24-alpine AS dependencies

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

FROM node:24-alpine AS runtime

ARG VCS_REF=""
ARG VERSION="dev"

LABEL org.opencontainers.image.title="LeLibrary" \
      org.opencontainers.image.description="Self-hosted LeLibrary addon for Stremio-compatible media clients" \
      org.opencontainers.image.source="https://github.com/leleasley/LeLibrary" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.revision="$VCS_REF" \
      org.opencontainers.image.version="$VERSION"

ENV NODE_ENV=production \
    PORT=7860

RUN apk add --no-cache font-liberation

# The setup store writes its generated server key to /data/setup.key when
# CONFIG_SECRET is unset. Create the directory as the runtime user BEFORE any
# volume is attached: Docker seeds a named volume with this ownership, and
# without it the node user cannot write the key and every saved setup becomes
# unreadable after a recreate.
RUN mkdir -p /data && chown node:node /data

WORKDIR /app
COPY --from=dependencies --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node . .
# Built SPA bundle (served by Express at /app). Source stays out of the image.
COPY --from=frontend --chown=node:node /frontend/dist ./frontend/dist

USER node
EXPOSE 7860
HEALTHCHECK --interval=60s --timeout=5s --retries=3 CMD wget -qO- http://127.0.0.1:7860/health || exit 1

CMD ["npm", "start"]
