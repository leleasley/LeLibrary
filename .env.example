PORT=7860
REDIS_HOST=redis
REDIS_PORT=6379
# Password for the bundled Postgres service in compose.example.yml, which backs
# the index-first library engine (the default core). Change it to something
# strong. Removing the Postgres service and DATABASE_URL runs the addon on the
# legacy request-time path instead.
DB_PASSWORD=change-me
# Optional, recommended: a separate non-superuser login for LeLibrary itself.
# Run selfhost/postgres-app-role.sql once (SETUP.md, "run the database as a
# normal login"), then point DATABASE_URL at lelibrary_app with this password.
# Generate with: openssl rand -hex 32
# DB_APP_PASSWORD=
# Server key for the setup store. Saved setups seal their API keys with this
# value (CONFIG_SECRET, else ENCRYPTION_KEY). Leave it empty and LeLibrary
# generates one at /data/setup.key, which compose.example.yml keeps in a named
# volume. Set it explicitly to survive even a volume loss. Generate it with:
# openssl rand -hex 32
CONFIG_SECRET=

# Required for self-hosted saved setups. Generate it with:
# openssl rand -hex 32
SELFHOST_CONFIGS_SECRET=

# "Back to a previous setup" list on /configure. On by default whenever
# SELFHOST_CONFIGS_SECRET is set. Anyone who can open /configure on this
# instance can see setup names, tiers and dates (never install links), so set
# this to "off" on an instance shared with people who should not see them.
# SELFHOST_LIST_SETUPS=off

# "Add your own addon" (Settle In / Move In) only reaches public HTTPS addons.
# On your own server you can allow addons on your local network or Tailscale
# (for example a StreamNZB box). Never enable this on a shared/public instance.
# CUSTOM_ADDONS_ALLOW_PRIVATE=on

# Stream sources this server cannot reach (comma-separated ids). They show as
# unavailable in setup and are skipped instead of returning an error, e.g. if
# Torrentio blocks your server's IP. Leave empty normally.
# STREAM_ADDONS_UNAVAILABLE=torrentio
# REDIS_PASSWORD=
# REDIS_TLS=false

# Optional account watchlist OAuth connections. Register these callback URLs:
# https://your-domain/api/setup/oauth/simkl/callback
# https://your-domain/api/setup/oauth/anilist/callback
# SIMKL_CLIENT_ID=
# SIMKL_CLIENT_SECRET=
# ANILIST_CLIENT_ID=
# ANILIST_CLIENT_SECRET=
# Trakt is only kept for setups already connected before 6.0. New setups
# cannot connect it (an API app needs Trakt VIP).
# TRAKT_CLIENT_ID=
# TRAKT_CLIENT_SECRET=

# Optional Cloudflare Turnstile bot protection for the edit unlock and
# setup-creation password screens: a visible managed widget sits under the
# password and the button waits for it. It is ON only when all three of the
# site key, the secret and the hostnames are set (startup logs
# "[Turnstile] enabled for N hostname(s)" or "[Turnstile] off (<reason>)").
# Each environment uses its own widget: dev and prod get different site keys
# AND secrets. Leave any of the three empty to disable it; self-hosted
# installs stay exactly as before.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET= (or TURNSTILE_SECRET_KEY: both accepted, TURNSTILE_SECRET wins)
# Comma-separated frontend hostnames a token must be issued for.
# TURNSTILE_HOSTNAME (singular) is accepted as an alias; the plural wins.
# Production must NOT include localhost or 127.0.0.1.
# TURNSTILE_HOSTNAMES=lelibrary.uk
# Optional kill switch: off, false or 0 turns Turnstile fully off (no widget,
# no check) without removing the keys. Any other value, or unset, = on when
# the three values above are present.
# TURNSTILE_ENABLED=off
# DEV/TEST ONLY: requests whose Host is localhost/127.0.0.1 skip the check and
# get no widget, so Playwright and curl work against the container port. Never
# set this on a shared or public instance (a spoofed Host header would bypass
# the gate if the app port is reachable).
# TURNSTILE_ALLOW_LOCALHOST=on

# Optional Pictorium poster studio. LeLibrary calls it server-side, so this URL
# is never exposed to users and may be an internal address. Leave unset when the
# companion container is named "pictorium" on the same Docker network (the
# built-in default already points there). Users can still bring their own
# instance from the Configure page; that field is public HTTPS only.
# PICTORIUM_URL=http://pictorium:8080

# ── Index-first library engine (default core) ──────────────────────────────
# With DATABASE_URL set (compose.example.yml provides it via DB_PASSWORD above)
# LeLibrary keeps a persistent local index of the debrid library in Postgres.
# Background sync then reconciles and matches items, and catalog/search/meta
# requests read from the local index instead of scanning the provider or calling
# TMDB. Without DATABASE_URL the addon automatically uses the legacy
# request-time path, and LIBRARY_ENGINE=legacy forces that path even with a
# database.
# LIBRARY_ENGINE=indexed

# Sync worker cadence (seconds) and metadata matching bounds.
# LIBRARY_SYNC_INTERVAL=120
# LIBRARY_MATCH_CONCURRENCY=4
# LIBRARY_MATCH_BATCH=50
# LIBRARY_MATCH_BUDGET_MS=30000

# Bounded first-load wait (ms) when a scope has never been indexed. After this
# the request returns whatever local rows exist and the sync continues.
# LIBRARY_FIRST_WAIT_MS=1500

# Search result cache TTL (seconds).
# LIBRARY_SEARCH_TTL=300

# Postgres pool for the library engine (falls back to DATABASE_URL).
# LIBRARY_DB_POOL_MAX=8
# LIBRARY_DB_STATEMENT_TIMEOUT=20000

# ── Identity / metadata enrichment (indexed engine, background only) ───────
# Cadence and bounds for the background identity+metadata resolver.
# LIBRARY_ENRICH_INTERVAL=20
# LIBRARY_ENRICH_BATCH=300
# LIBRARY_ENRICH_CONCURRENCY=3
# Optional TVDB v4 API key. Without it, TVDB ids are derived from the local
# Wikidata map (no API traffic); with it, TVDB search/aliases/episodes are used.
# TVDB_API_KEY=
# Kitsu episode pages stored per anime (20 episodes per page).
# ANIME_EPISODE_PAGES=5
# IDENTITY_HTTP_TIMEOUT=12000
