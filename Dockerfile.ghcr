FROM node:24-alpine AS dependencies

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

FROM node:24-alpine AS runtime

ARG VCS_REF=""
ARG VERSION="dev"

LABEL org.opencontainers.image.title="LeLibrary" \
      org.opencontainers.image.description="Self-hosted LeLibrary addon for Stremio-compatible media clients" \
      org.opencontainers.image.source="https://github.com/leleasley/LeLibrary" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.revision="$VCS_REF" \
      org.opencontainers.image.version="$VERSION"

ENV NODE_ENV=production \
    PORT=7860

RUN apk add --no-cache font-liberation

WORKDIR /app
COPY --from=dependencies --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node . .

USER node
EXPOSE 7860
HEALTHCHECK --interval=60s --timeout=5s --retries=3 CMD wget -qO- http://127.0.0.1:7860/health || exit 1

CMD ["node", "index.js"]
