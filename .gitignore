# ── Secrets and instance config ─────────────────────────────────────────
# Never commit an instance's keys. compose.example.yml and .env.example are
# the public templates.
.env
.env.*
!.env.example
*.pem
*.key
*.crt
compose.yml
compose.indexed.yml

# ── Private to the hosted instance (lelibrary.uk) ───────────────────────
# Copied into production by the deploy scripts, never from GitHub.
# Self-hosters get the generic manifest, /configure for / and /privacy, no
# status page, generated folder covers and no Guide videos.
AGENTS.md
Docs/
/scripts/
/promo/
# Addon identity (id, description, Stremio registry signature).
backend/src/registry.ts
# Lists production URLs.
frontend/public/sitemap.xml
# Hosted-only site pages. The shared shell, Guide, assets and build scripts
# stay public.
frontend/src/features/site/HomePage.tsx
frontend/src/features/site/home-data.ts
frontend/src/features/site/home.css
frontend/src/features/site/PrivacyPage.tsx
frontend/src/features/site/privacy.css
frontend/src/features/site/StatusPage.tsx
frontend/src/features/site/status.css
# Guide walkthrough videos (built by promo/guide).
frontend/public/guide/videos/
# LeLibrary's own collection folder art (shipped inside the hosted bundle).
frontend/public/collection-art/
# Dev-only artwork review page (deploy-oracle.sh drops it).
frontend/public/art-review/

# ── Generated ───────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
coverage/
.nyc_output/
test-results/
tmp-fixture/
*.log
logs/

# ── Editors and OS ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Pre-5.5 layout ──────────────────────────────────────────────────────
# Nothing here exists any more. Kept so an old-layout tree (a 5.x rollback
# extracted into a checkout) can never be committed: it held the private
# website, the accounts area and the private addon identity.
/website/
/src/
/test/
