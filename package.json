{
  "name": "lelibrary",
  "version": "5.7.1",
  "description": "LeLibrary: TorBox & Real-Debrid addon with TMDB metadata",
  "main": "backend/index.ts",
  "license": "AGPL-3.0-only",
  "scripts": {
    "start": "node backend/index.ts",
    "dev": "node --watch backend/index.ts",
    "test": "node --test \"backend/test/**/*.test.*\"",
    "test:library": "node --test backend/test/library-index.test.ts backend/test/library-store.test.ts",
    "bench:library": "node scripts/library-bench.js",
    "bench:match": "scripts/match-bench.sh",
    "fixture:library": "node scripts/library-fixture.js",
    "audit:imported-sources": "node scripts/audit-imported-sources.js",
    "check:curated-artwork": "node scripts/check-curated-artwork.js",
    "typecheck": "tsc -p backend/tsconfig.json"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "compression": "^1.7.5",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "ioredis": "^6.0.0",
    "node-cache": "^5.1.2",
    "pg": "^8.23.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "qs": "^6.16.0",
    "brace-expansion": "^5.0.12",
    "proxy-addr": "^2.0.8"
  },
  "engines": {
    "node": "24"
  }
}
